# Variables de la aplicación web. Copiar a .env.local; nunca versionar .env ni .env.local.
# Vacías = valor por defecto de src/config/env.ts (despliegue público). Se validan al iniciar.
# Todo origen externo nuevo debe añadirse también a la CSP de vercel.json (src/config/config.test.ts lo comprueba).

# --- Públicas (VITE_*): llegan al navegador; nunca poner secretos aquí ---
# API: ruta del mismo origen (/api, reenviada por Vite y por vercel.json) o URL https absoluta.
VITE_API_BASE_URL=
# Tiempo máximo de cada petición a la API, en milisegundos.
VITE_API_TIMEOUT_MS=
# Proyecto de Supabase (solo la clave anónima). Sin ambas, la app funciona solo en el dispositivo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Destino de los enlaces de confirmación por correo. Vacío = origen desde el que se registró la persona.
VITE_AUTH_REDIRECT_URL=
# ID de cliente OAuth de Google (público; termina en .apps.googleusercontent.com). Con él, «Continuar con Google»
# usa el selector de cuentas del navegador y el aviso nombra este sitio; sin él, se redirige por Supabase.
VITE_GOOGLE_CLIENT_ID=
# Recursos versionados del modelo (manifiesto, etiquetas, nombres de especies).
VITE_MODEL_ASSETS_BASE_URL=
# Estilos del mapa (tema claro y oscuro).
VITE_MAP_STYLE_LIGHT_URL=
VITE_MAP_STYLE_DARK_URL=
# Vista inicial del mapa: "longitud,latitud" y nivel de zoom (0-22).
VITE_MAP_INITIAL_CENTER=
VITE_MAP_INITIAL_ZOOM=
# Zona horaria IANA cuando el dispositivo no informa la suya.
VITE_DEFAULT_TIME_ZONE=
# Fotos de especies: API de búsqueda, API de metadatos (autoría y licencia), hosts de imagen permitidos
# separados por comas y tiempo máximo de cada petición en milisegundos. Los hosts de imagen van en img-src
# y en connect-src de la CSP: el service worker vuelve a descargarlas para la caché sin conexión. Por defecto,
# thumb.wikimedia.org (miniaturas que entrega Commons) y upload.wikimedia.org (originales).
VITE_PHOTO_LOOKUP_API_URL=
VITE_PHOTO_METADATA_API_URL=
VITE_PHOTO_IMAGE_HOSTS=
VITE_PHOTO_TIMEOUT_MS=
# Resúmenes de Wikipedia para las fichas de especie (por defecto, API REST de es.wikipedia.org y en.wikipedia.org)
VITE_SUMMARY_API_URL_ES=
VITE_SUMMARY_API_URL_EN=

# --- Solo desarrollo local (sin prefijo VITE_, nunca llegan al navegador) ---
# Vacías = BUILD_ENV_DEFAULTS de build.config.mjs (API local en 127.0.0.1 y puertos por defecto de Vite).
# Destino (URL http/https) al que Vite reenvía /api en `npm run dev` y `npm run preview`.
API_PROXY_TARGET=
# Puertos de `npm run dev` y `npm run preview`.
DEV_PORT=
PREVIEW_PORT=

# En producción /api se reenvía a la API según el rewrite de vercel.json (Vercel no lee variables en ese
# archivo): cambiar allí el destino si la API se despliega en otra URL.
